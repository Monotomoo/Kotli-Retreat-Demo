# Analytics — set these in Vercel → Project → Settings → Environment Variables,
# then redeploy. Until they are set, no analytics scripts load at all.

# Google Analytics 4 Measurement ID (from GA4 → Admin → Data Streams)
NEXT_PUBLIC_GA_ID=

# Google Ads Conversion ID (add later when running campaigns), e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
