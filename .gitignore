# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# v2-only repository.
# Darko's original design stays in the working copy for local
# side-by-side comparison at /istria-original, but is never pushed:
# its Hero.tsx calls useSearchParams() without a Suspense boundary,
# which fails `next build` on Next 16 and would block deployment.
# A pristine untouched copy also lives in the sibling folder
# "Istra SS project Darko original".
# ---------------------------------------------------------------
/src/app/\[locale\]/istria-original/

# Original section components (superseded by src/components/v2/)
/src/components/*.tsx
!/src/components/WhatsAppFloat.tsx
!/src/components/StickyMobileCta.tsx
!/src/components/CookieBanner.tsx

# Original A/B/C design variants and motion helpers
/src/components/accommodation-variants/
/src/components/agenda-variants/
/src/components/contact-variants/
/src/components/hero-variants/
/src/components/includes-variants/
/src/components/why-variants/
/src/components/motion/

# Local dev screenshot scripts
/scripts/
